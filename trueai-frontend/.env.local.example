# Copy to .env.local and fill in. All four are required.

# Supabase project (Project Settings -> API). The anon key is safe in the
# browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The TrueAI FastAPI backend. Only the Next.js server calls it, so it can be
# an internal address in production (for example http://api:8000).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public URL of this frontend. Used for metadata and the Supabase auth
# redirect links (add it under Authentication -> URL Configuration too).
NEXT_PUBLIC_APP_URL=http://localhost:3000
