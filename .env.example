# ═══════════════════════════════════════════════════════════════════
# TrueAI backend configuration — copy to .env and fill in.
# Required values are marked (required); everything else has a default.
# ═══════════════════════════════════════════════════════════════════

# ---- Application ---------------------------------------------------
ENV=development                          # development | staging | production
BASE_URL=http://localhost:8000           # public URL of this API (Sentry + GitHub call it)
FRONTEND_URL=http://localhost:3000       # public URL of the dashboard
CORS_ORIGINS=http://localhost:3000       # comma-separated
# ALLOWED_HOSTS=api.example.com          # Host header allow-list (default: any)
# TRUST_PROXY_HEADERS=false              # true only behind a trusted reverse proxy

# (required) 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_SECRET=

# ---- LLM (defaults shared by every agent) --------------------------
LLM_PROVIDER=groq                        # groq | openai | anthropic
LLM_MODEL=openai/gpt-oss-120b            # run `GET https://api.groq.com/openai/v1/models` to see what your key can use
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192                      # reasoning models spend part of this thinking
# LLM_REASONING_EFFORT=medium            # low | medium | high (gpt-oss / o-series)
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_ATTEMPTS=4
# Model tried once when the primary is unavailable (set empty to disable):
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
# LLM_FALLBACK_PROVIDER=groq

GROQ_API_KEY=                            # required for the groq provider
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                       # any OpenAI-compatible endpoint (Azure, OpenRouter, vLLM, Ollama)
# ANTHROPIC_API_KEY=                     # also: pip install langchain-anthropic

# ---- Per-agent model overrides (optional) --------------------------
# Agents: TRIAGE, INVESTIGATOR, FIX_ENGINEER, REVIEWER, REMEDIATION
# AGENT_FIX_ENGINEER_PROVIDER=openai
# AGENT_FIX_ENGINEER_MODEL=gpt-4.1
# AGENT_REVIEWER_PROVIDER=anthropic
# AGENT_REVIEWER_MODEL=claude-sonnet-5
# AGENT_TRIAGE_MODEL=openai/gpt-oss-20b     # a smaller, faster model is plenty for triage
# AGENT_INVESTIGATOR_TEMPERATURE=0
# AGENT_REMEDIATION_MAX_TOKENS=2048

# ---- Pipeline tuning (optional) ------------------------------------
# CONFIDENCE_AUTO_PR_THRESHOLD=0.75      # min confidence to open a PR automatically
# CONFIDENCE_MIN_FIX_THRESHOLD=0.40      # below this, no fix is attempted
# MAX_INVESTIGATION_ROUNDS=2
# MAX_FIX_ATTEMPTS=3
# MAX_CONTEXT_FILES=6
# MAX_PATCH_FILES=5
# MAX_PATCH_CHANGED_LINES=200
# INCIDENT_GROUPING_WINDOW_HOURS=24
# PIPELINE_TIMEOUT_SECONDS=540
# PR_AS_DRAFT=false
# PR_LABEL=trueai

# ---- Supabase ------------------------------------------------------
SUPABASE_URL=                            # (required) https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # (required) server-side only — never expose
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=                   # only for legacy projects still signing with HS256

# ---- Redis / Celery ------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- GitHub OAuth App ----------------------------------------------
# Authorization callback URL in the GitHub OAuth App: <BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=                        # (required)
GITHUB_CLIENT_SECRET=                    # (required)
# (required) Fernet key(s) encrypting every stored secret; comma-separate to rotate (first encrypts).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=

# ---- Sentry (optional global fallbacks; users can set their own in Integrations)
# SENTRY_WEBHOOK_SECRET=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG_SLUG=
# SENTRY_API_BASE_URL=https://sentry.io
# SENTRY_ALLOWED_HOSTS=sentry.io,*.sentry.io

# ---- Abuse protection (optional) -----------------------------------
# RATE_LIMIT_PER_MINUTE=60               # webhook deliveries per API key
# API_RATE_LIMIT_PER_MINUTE=300          # dashboard API calls per user
# REANALYZE_LIMIT_PER_HOUR=20
# WEBHOOK_MAX_BODY_BYTES=2097152
# MAX_ACTIVE_API_KEYS=10

# ---- Logging -------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=text                        # json for log aggregators
# LOG_DIR=logs                           # empty = stdout only (containers)
